
name: Build StreetMind NPC

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Java 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: temurin

      - name: Install Gradle 8.10.2
        run: |
          wget https://services.gradle.org/distributions/gradle-8.10.2-bin.zip
          unzip gradle-8.10.2-bin.zip
          echo "$PWD/gradle-8.10.2/bin" >> $GITHUB_PATH

      - name: Extract project
        run: |
          mkdir -p extracted
          unzip -o ./*.zip -d extracted

      - name: Compile StreetMind NPC
        run: |
          cd extracted
          PROJECT_DIR=$(find . -name build.gradle -o -name build.gradle.kts | head -n 1 | xargs dirname)
          cd "$PROJECT_DIR"
          gradle build

      - name: Upload compiled mod
        uses: actions/upload-artifact@v4
        with:
          name: StreetMindNPC-mod
          path: extracted/**/build/libs/*.jar
          if-no-files-found: error

